  <diagram id="fig_architecture" name="Architecture">
    <mxGraphModel dx="1115" dy="420" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1115" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
