        </mxCell>


        <!-- ========================================== -->
        <!-- S-NACK RETRANSMISSION PROTOCOL (BOTTOM)    -->
        <!-- ========================================== -->
        <mxCell id="snack_banner" value="&lt;b style=&quot;color:#991b1b;font-size:12px;&quot;&gt;CLOSED-LOOP S-NACK RETRANSMISSION PROTOCOL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#7f1d1d;font-size:10.5px;&quot;&gt;Smart Recovery: Requests only missing high-&amp;gamma;&lt;sub&gt;k&lt;/sub&gt; bands (&amp;Delta;k &amp;approx; 1.2 MB, &amp;Delta;t &amp;approx; 15 ms) &amp;mdash; Avoids 200 MB full retransmission&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=1.3;arcSize=3;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="220" y="314" width="620" height="44" as="geometry" />
        </mxCell>

        <!-- Return Arrow 1: Downward from card_fail to S-NACK banner -->
        <mxCell id="arr_snack_down" value="&lt;b style=&quot;color:#b91c1c;font-size:10px;&quot;&gt;Audit Failed&lt;br&gt;(Stroke Erased)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;strokeWidth=2.2;fontColor=#b91c1c;fontSize=10;fontFamily=Helvetica;align=left;spacingLeft=6;endArrow=block;endFill=1;endSize=4;" edge="1" parent="1">
