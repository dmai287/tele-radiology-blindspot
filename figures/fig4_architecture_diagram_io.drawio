        <mxCell id="title" value="&lt;b style=&quot;font-size:15px;color:#0f172a;&quot;&gt;FOUR-LAYER DIAGNOSTIC-AWARE TELE-RADIOLOGY ARCHITECTURE (DARDO + CSA + 5G URLLC)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#475569;&quot;&gt;Mobile Stroke Unit (MSU) Scanner &amp;rarr; Dual-Slice 5G Cellular RAN &amp;rarr; Hospital Edge AI Safety Audit&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="4" width="1115" height="34" as="geometry" /></mxCell>
        <mxCell id="col_tx" value="&lt;b&gt;TRANSMITTER: MOBILE STROKE UNIT (MSU)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#0f172a;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=center;swimlaneFillColor=#f8fafc;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="12" y="44" width="306" height="304" as="geometry" /></mxCell>
        <mxCell id="col_ran" value="&lt;b&gt;5G / B5G CELLULAR RADIO ACCESS NETWORK&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#0f172a;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=center;swimlaneFillColor=#f8fafc;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="398" y="44" width="320" height="304" as="geometry" /></mxCell>
        <mxCell id="col_rx" value="&lt;b&gt;RECEIVER: HOSPITAL EDGE SERVER&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#0f172a;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#ffffff;fontFamily=Helvetica;fontSize=12;align=center;swimlaneFillColor=#f8fafc;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="798" y="44" width="306" height="304" as="geometry" /></mxCell>
        <mxCell id="l1" value="&lt;div style=&quot;width:288px;height:114px;display:flex;flex-direction:column;justify-content:space-between;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;background:#e3ebf2;color:#2e4a66;font-weight:bold;font-size:11.5px;text-align:center;padding:4px 0;border-bottom:1px solid #b3c6d8;border-radius:3px 3px 0 0;&quot;&gt;LAYER 1: TASK PROFILER (CSA) &lt;span style=&quot;font-weight:normal;font-size:10px;&quot;&gt;&amp;mdash; Lesion Prior&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;padding:5px 12px 0 12px;font-size:11px;line-height:1.5;color:#334155;text-align:left;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Raw Data:&lt;/b&gt; Multi-coil &lt;i&gt;k&lt;/i&gt;-space &lt;b&gt;Y&lt;/b&gt; &amp;isin; &amp;#x2102;&lt;sup&gt;C&amp;times;K&lt;/sup&gt;&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Task Prior:&lt;/b&gt; &lt;b style=&quot;color:#3d6a8f;&quot;&gt;&lt;i&gt;W(k&lt;sub&gt;x&lt;/sub&gt;,k&lt;sub&gt;y&lt;/sub&gt;) = |&amp;#x2131;{w&lt;sub&gt;CHO&lt;/sub&gt;}|&lt;sup&gt;2&lt;/sup&gt;&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin:0 8px 7px 8px;background:#f4f7fa;border:1px solid #b3c6d8;border-radius:3px;color:#3d6a8f;font-size:11px;font-weight:bold;text-align:center;padding:3px 2px;&quot;&gt;Safety Target: Detectability &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;CHO&lt;/sub&gt; &amp;ge; 2.0&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d6e2;strokeWidth=1.2;overflow=hidden;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="col_tx"><mxGeometry x="8" y="32" width="290" height="116" as="geometry" /></mxCell>
        <mxCell id="l2" value="&lt;div style=&quot;width:288px;height:114px;display:flex;flex-direction:column;justify-content:space-between;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;background:#e2eeec;color:#2f6a5c;font-weight:bold;font-size:11.5px;text-align:center;padding:4px 0;border-bottom:1px solid #b2d1c8;border-radius:3px 3px 0 0;&quot;&gt;LAYER 2: DIAGNOSTIC COMPRESSION (DARDO)&lt;/div&gt;&lt;div style=&quot;padding:5px 12px 0 12px;font-size:11px;line-height:1.5;color:#334155;text-align:left;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Diagnostic Grad:&lt;/b&gt; &lt;b style=&quot;color:#2f6a5c;&quot;&gt;&amp;gamma;&lt;sub&gt;k&lt;/sub&gt; = &amp;sum;&lt;sub&gt;y&lt;/sub&gt; W(k,y) ||&amp;#x2131;S&lt;sub&gt;k&lt;/sub&gt;||&lt;sub&gt;2&lt;/sub&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Greedy Split:&lt;/b&gt; Sort in &amp;lt; 2 ms &amp;rArr; &lt;b style=&quot;color:#3b6ea5;&quot;&gt;K&lt;sub&gt;diag&lt;/sub&gt;&lt;/b&gt; vs. &lt;b style=&quot;color:#64748b;&quot;&gt;K&lt;sub&gt;bulk&lt;/sub&gt;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin:0 8px 7px 8px;background:#f2f7f5;border:1px solid #b2d1c8;border-radius:3px;color:#2f5f52;font-size:11px;font-weight:bold;text-align:center;padding:3px 2px;&quot;&gt;Safety Probe: 128-B Token &amp;theta; in Header&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cadfd8;strokeWidth=1.2;overflow=hidden;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="col_tx"><mxGeometry x="8" y="180" width="290" height="116" as="geometry" /></mxCell>
        <mxCell id="urllc" value="&lt;div style=&quot;width:302px;height:114px;display:flex;flex-direction:column;justify-content:space-between;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;background:#e3ecf6;color:#2b5a8a;font-weight:bold;font-size:11.5px;text-align:center;padding:4px 0;border-bottom:1px solid #aec5de;border-radius:3px 3px 0 0;&quot;&gt;LAYER 3: 5G URLLC SLICE (MISSION-CRITICAL)&lt;/div&gt;&lt;div style=&quot;padding:5px 12px 0 12px;font-size:11px;line-height:1.5;color:#334155;text-align:left;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Payload:&lt;/b&gt; &lt;b style=&quot;color:#3b6ea5;&quot;&gt;K&lt;sub&gt;diag&lt;/sub&gt; = {k | &amp;gamma;&lt;sub&gt;k&lt;/sub&gt; &amp;ge; &amp;tau;}&lt;/b&gt; + &lt;b style=&quot;color:#2f6a5c;&quot;&gt;Token &amp;theta;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;3GPP QoS:&lt;/b&gt; 5QI 82&amp;ndash;85 (BLER &amp;lt; 10&lt;sup&gt;&amp;minus;5&lt;/sup&gt;, &amp;lt; 10 ms)&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin:0 8px 7px 8px;background:#f4f8fc;border:1px solid #aec5de;border-radius:3px;color:#2b5a8a;font-size:11px;font-weight:bold;text-align:center;padding:3px 2px;&quot;&gt;Channel: Dedicated BWP (Zero Burst Drop)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d8ea;strokeWidth=1.2;overflow=hidden;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="col_ran"><mxGeometry x="8" y="32" width="304" height="116" as="geometry" /></mxCell>
        <mxCell id="embb" value="&lt;div style=&quot;width:302px;height:114px;display:flex;flex-direction:column;justify-content:space-between;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;background:#f1f5f9;color:#334155;font-weight:bold;font-size:11.5px;text-align:center;padding:4px 0;border-bottom:1px solid #cbd5e1;border-radius:3px 3px 0 0;&quot;&gt;LAYER 3: 5G eMBB SLICE (BULK ANATOMY)&lt;/div&gt;&lt;div style=&quot;padding:5px 12px 0 12px;font-size:11px;line-height:1.5;color:#334155;text-align:left;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Bulk Payload:&lt;/b&gt; &lt;b style=&quot;color:#475569;&quot;&gt;K&lt;sub&gt;bulk&lt;/sub&gt; = {k | &amp;gamma;&lt;sub&gt;k&lt;/sub&gt; &amp;lt; &amp;tau;}&lt;/b&gt; &lt;i style=&quot;color:#64748b;&quot;&gt;(Skull Context)&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Policy:&lt;/b&gt; Dynamic DASH Streaming &lt;i style=&quot;color:#64748b;&quot;&gt;(Loss-Tolerant)&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin:0 8px 7px 8px;background:#f8fafc;border:1px solid #94a3b8;border-radius:3px;color:#475569;font-size:11px;font-weight:bold;text-align:center;padding:3px 2px;&quot;&gt;Throughput: Best-Effort (Absorbs Congestion)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.2;overflow=hidden;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="col_ran"><mxGeometry x="8" y="180" width="304" height="116" as="geometry" /></mxCell>
        <mxCell id="recon" value="&lt;div style=&quot;width:288px;height:114px;display:flex;flex-direction:column;justify-content:space-between;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;background:#ebe9f1;color:#4f4a73;font-weight:bold;font-size:11.5px;text-align:center;padding:4px 0;border-bottom:1px solid #c5c1d6;border-radius:3px 3px 0 0;&quot;&gt;EDGE AI RECONSTRUCTION (VarNet)&lt;/div&gt;&lt;div style=&quot;padding:5px 12px 0 12px;font-size:11px;line-height:1.5;color:#334155;text-align:left;&quot;&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Stream Fusion:&lt;/b&gt; &lt;b&gt;Y&lt;/b&gt;&lt;sub&gt;URLLC&lt;/sub&gt; &amp;cup; &lt;b&gt;Y&lt;/b&gt;&lt;sub&gt;eMBB&lt;/sub&gt;&lt;/div&gt;&lt;div&gt;&amp;bull; &lt;b style=&quot;color:#0f172a;&quot;&gt;Deep Recon:&lt;/b&gt; &lt;b style=&quot;color:#4f4a73;&quot;&gt;X&amp;#770; = &amp;#x211b;&lt;sub&gt;&amp;theta;&lt;/sub&gt;(Y)&lt;/b&gt; in 1.8 s on Edge GPU&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;margin:0 8px 7px 8px;background:#f6f5f9;border:1px solid #c5c1d6;border-radius:3px;color:#5a5480;font-size:10px;font-weight:bold;text-align:center;padding:3px 2px;&quot;&gt;Residual: Passed ||AX&amp;#770; &amp;minus; Y|| &amp;lt; &amp;sigma;&lt;sub&gt;&amp;eta;&lt;/sub&gt; (Null-Space Blind)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6d3e2;strokeWidth=1.2;overflow=hidden;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="col_rx"><mxGeometry x="8" y="32" width="290" height="116" as="geometry" /></mxCell>
        <mxCell id="l4" value="&lt;div style=&quot;width:288px;height:114px;display:flex;flex-direction:column;justify-content:space-between;font-family:Helvetica,Arial,sans-serif;&quot;&gt;&lt;div style=&quot;background:#f1e5e5;color:#7a3a3a;font-weight:bold;font-size:11.5px;text-align:center;padding:4px 0;border-bottom:1px solid #dbc1c1;border-radius:3px 3px 0 0;&quot;&gt;LAYER 4: SEMANTIC AUDIT &amp;amp; DECISION GATE&lt;/div&gt;&lt;div style=&quot;margin:5px 8px 0 8px;background:#f2f7f5;border:1px solid #b2d1c8;border-radius:3px;padding:2px 7px;text-align:left;line-height:1.3;&quot;&gt;&lt;b style=&quot;color:#2f6a5c;font-size:11px;&quot;&gt;&amp;#x2714; z &amp;ge; 2.0 (AUDIT PASSED: STROKE INTACT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2f5f52;font-size:9.5px;&quot;&gt;&lt;i&gt;z&lt;/i&gt;&lt;sub&gt;recon&lt;/sub&gt; &amp;ge; &lt;i&gt;z&lt;/i&gt;&lt;sub&gt;miss&lt;/sub&gt; &amp;rarr; Released to PACS &amp;amp; Clinician&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin:5px 8px 0 8px;background:#f8f1f0;border:1px solid #d9b3ae;border-radius:3px;padding:2px 7px;text-align:left;line-height:1.3;&quot;&gt;&lt;b style=&quot;color:#8c3a32;font-size:11px;&quot;&gt;&amp;#x2718; z &amp;lt; 2.0 (AUDIT FAILED: STROKE ERASED)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#a8463d;font-size:9.5px;&quot;&gt;&lt;b&gt;Silent Erasure Alert &amp;rArr; Trigger Targeted S-NACK&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;height:6px;&quot;&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dbc1c1;strokeWidth=1.2;overflow=hidden;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="col_rx"><mxGeometry x="8" y="180" width="290" height="116" as="geometry" /></mxCell>
